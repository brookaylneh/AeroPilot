# Web server (loopback by default)
HOST=127.0.0.1
PORT=3001
SNR_STATIC_DIR=dist
PIXEL_PLAYER_PORT=8080
PIXEL_STREAMER_PORT=8888

# Packaged Unreal runtime: use absolute paths in systemd/container configuration.
# SNR_PACKAGE_ROOT=/absolute/path/to/world/unreal/releases/<release>
# SNR_COSYS_SETTINGS=/absolute/path/to/release/cosys-settings.json
# SNR_WORLD_CONFIG=/absolute/path/to/release/world.json
# SNR_DRONE_DATA_DIR=/absolute/path/to/data/four-drones
# SNR_SCENARIO_DATA_DIR=/absolute/path/to/data/unreal-scenarios
SNR_COSYS_PORT=41451
SNR_CPU_LIMIT=6
SNR_MEMORY_LIMIT=24g
SNR_UNREAL_IMAGE=snr-unreal-runtime:5.8.2-ubuntu24.04
SNR_STREAM_CODEC=H264
VITE_STREAM_CODEC=H264
SNR_STREAM_FPS=60
SNR_STREAM_HEIGHT=1080
SNR_STREAM_MAX_BITRATE=20000000
# UE_ROOT is required for editor/build modes only.
# UE_ROOT=/absolute/path/to/UnrealEngine/5.8.2
# SNR_TURN_CONFIG=/absolute/path/to/.secrets/turn.json
# PLAYWRIGHT_CHROMIUM_PATH=/absolute/path/to/chromium

# Model services; loaded by mission_control.environment.
FAL_KEY=
HF_TOKEN=
MODEL_API_KEY=
GLIMMER_URL=
SAM_URL=
