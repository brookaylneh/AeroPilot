# Model credentials and endpoints, loaded by mission_planner.environment.load_env.
# Runtime configuration (ports, paths, stream profile) lives in .local/runtime.env;
# see deploy/runtime.env.example.
HF_TOKEN=
MODEL_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
SAM_URL=
GLIMMER_URL=
# Full Authorization header per model endpoint; changing provider changes only these and the URLs.
# Modal proxy token: "Bearer <token id>.<token secret>".
SAM_AUTHORIZATION=
GLIMMER_AUTHORIZATION=
