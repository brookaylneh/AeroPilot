# Packaged application on a 32 GB host. 60 FPS is a test target, not a measured guarantee.
SNR_UNREAL_IMAGE=snr-unreal-runtime:5.8.2-ubuntu24.04
SNR_CONTAINER_NAME=snr-unreal-live
SNR_CPU_LIMIT=6
SNR_MEMORY_LIMIT=24g
SNR_PACKAGE_ROOT=/srv/snr/unreal/Live
SNR_COSYS_SETTINGS=/srv/snr/unreal/Live/cosys-settings.json
SNR_WORLD_CONFIG=/srv/snr/unreal/Live/world.json
SNR_DRONE_DATA_DIR=/srv/snr/data/four-drones
SNR_SCENARIO_DATA_DIR=/srv/snr/data/unreal-scenarios
SNR_COSYS_PYTHON=/srv/snr/.venv-cosys/bin/python
SNR_COSYS_PORT=41451
SNR_STREAM_CODEC=H264
SNR_STREAM_HEIGHT=1080
SNR_STREAM_FPS=60
# Viewer Wi-Fi measured 53 Mbps with bufferbloat; the floor stops WebRTC
# collapsing to ~2 Mbps, and the ceiling leaves headroom on that link.
SNR_STREAM_MAX_BITRATE=25000000
SNR_STREAM_MIN_BITRATE=10000000
# SNR_STREAM_TARGET_BITRATE=15000000  # last resort: ignores congestion control
SNR_MEDIA_CAPTURE=1
SNR_RHI_THREAD=1
SNR_PROFILE=0
