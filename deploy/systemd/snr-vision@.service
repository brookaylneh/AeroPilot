[Unit]
Description=SNR local SAM 3.1 fleet vision, slot %i
Wants=docker.service
After=docker.service

[Service]
Type=notify
NotifyAccess=main
KillMode=mixed
Environment=PYTHONPATH=@ROOT@
ExecStartPre=/usr/bin/mkdir -p @ROOT@/.local/run
ExecStart=@ROOT@/.venv-cosys/bin/python -m mission_planner.agents.services.run_vision
TimeoutStartSec=920

[Install]
WantedBy=multi-user.target
