[Unit]
Description=SNR packaged Unreal world
Requires=docker.service snr-signalling.service
After=docker.service nvidia-persistenced.service snr-signalling.service

[Service]
Type=simple
ExecStart=/usr/bin/bash world/unreal/scripts/unreal-container.sh run-packaged
ExecStop=/usr/bin/docker stop --time=60 ${SNR_CONTAINER_NAME}

[Install]
WantedBy=multi-user.target
