[Unit]
Description=SNR mission owner and ArduPilot fleet, slot %i
After=network-online.target snr-vision@%i.service snr-unreal@%i.service
Wants=network-online.target snr-vision@%i.service snr-unreal@%i.service

[Service]
Type=simple
ExecStartPre=/usr/bin/bash deploy/wait-cosys.sh
ExecStart=@ROOT@/.venv-cosys/bin/python -m mission_planner.gcs.host
TimeoutStartSec=150
KillMode=mixed

[Install]
WantedBy=multi-user.target
