+void AirSim::update_battery(const sitl_input &input)
+{
+    const auto *params = AP::sitl();
+    if (params == nullptr || !is_positive(params->batt_capacity_ah) || !is_positive(params->batt_voltage)) {
+        AP_HAL::panic("AirSim requires positive SIM_BATT_CAP_AH and SIM_BATT_VOLTAGE");
+    }
+    if (!battery_initialized) {
+        // Same 50 A full-throttle / 0.7 V sag model as SITL_State_Common.
+        battery.setup(params->batt_capacity_ah, 0.7f / 50.0f, params->batt_voltage);
+        battery.init_voltage(params->batt_voltage);
+        last_param_voltage = params->batt_voltage;
+        battery_initialized = true;
+    }
+    // Like Frame::current_and_voltage, a changed SIM_BATT_VOLTAGE or SIM_BATT_CAP_AH
+    // re-initialises the state of charge, so a landed fleet can be refilled by parameter.
+    if (!is_equal(last_param_voltage, params->batt_voltage.get())) {
+        battery.init_voltage(params->batt_voltage);
+        last_param_voltage = params->batt_voltage;
+    }
+    if (!is_equal(battery.get_capacity(), params->batt_capacity_ah.get())) {
+        battery.init_capacity(params->batt_capacity_ah);
+    }
+    motor_mask = 0x0f;
+    battery_current = 0;
+    for (uint8_t i = 0; i < 4; i++) {
+        battery_current += 12.5f * constrain_float((input.servos[i] - 1000) / 1000.0f, 0.0f, 1.0f);
+    }
+    battery.set_current(battery_current);
+    battery_voltage = battery.get_voltage();
+}
