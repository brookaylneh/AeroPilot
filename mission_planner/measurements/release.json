  "flexibility": {
    "observation_steps": ["fly", "follow", "survey", "circle"],
    "selection": "Optional observe:true on existing finite movement steps; unobserved steps are transit. One optional target/review policy and simple polygon. Wonder chooses one to four aircraft, shape, pattern and SAM prompt.",
    "patterns": [
      "Parallel track and creeping line via survey bearing/geometry",
      "Route/track-line via follow",
      "Expanding square via a pure tool returning an ordinary follow step",
      "Point orbit via circle"
    ],
    "explicit_inspection": "Hover, building faces and elevated targets use set_camera_view, start_inspection and wait_for. No automatic hover checkpoint because timed loiter resumes by restarting its dwell timer.",
    "limits": "Universal flight checks unchanged. Observed survey spacing and polygon/connector checks remain. Exact read-back fences, measured homes, altitude frame, spatial reservation semantics and numeric limits are supplied to Wonder.",
    "race_checks": "Observation is rechecked after aim/capture; expired or replaced observed steps cannot acquire tracking or hold later flight. Late-positive source evidence and Glimmer review remain pending with exact error.",
    "review_template": "forward-analyst-v2; generic target wording. Existing model build, provider and fixed sampling unchanged. Prior recognition measurements do not transfer to the changed template."
  },
