  "research": {
    "date": "2026-10-28",
    "scope": "Realistic full-body human source meshes for later MetaHuman authoring; no imports or roster replacement",
    "current_hunyuan": {
      "endpoint": "fal-ai/hunyuan-3d/v3.1/pro/image-to-3d",
      "face_count": 1500000,
      "enable_pbr": true,
      "inputs": "one front image",
      "assessment": "Already at maximum exposed polygon target with PBR. A rerun can vary, but no evidence that rerolling fixes systematic face/hair loss. Extra consistent views address unseen surfaces."
    },
    "candidates": [
      {
        "model": "Meshy 7.1",
        "endpoint": "fal-ai/meshy/v7.1/image-to-3d",
        "test": "Same adult-01 source; standard 4K geometry; remesh false; PBR true; original pose; no rigging",
        "limit": "fal schema has no texture-resolution selector. Native Meshy API exposes 2K/4K/8K."
      },
      {
        "model": "TRELLIS 2",
        "endpoint": "fal-ai/trellis-2",
        "controls": "Single input; resolution up to 1536; textures up to 4096; PBR; seed and guidance/steps",
        "assessment": "Useful controlled alternative, not established as the strongest face reconstructor. Higher guidance/steps can create artifacts; no universal maximum-quality settings demonstrated."
      },
      {
        "model": "Hi3D portrait 2.1",
        "endpoint": "hitem3d/hi3d/image-to-3d",
        "controls": "scene-portraitv2.1, 1536pro, textures and PBR",
        "assessment": "Explicit portrait/character specialization makes this a relevant candidate; not yet tested on our inputs."
      },
      {
        "model": "Hi3D 3.0",
        "endpoint": "hitem3d/hi3d/v3.0/image-to-3d",
        "controls": "2048master; recommended target 5M faces; PBR",
        "assessment": "General model, not proof of superiority to the portrait specialization."
      },
      {
        "model": "Rodin 2.5",
        "endpoint": "fal-ai/hyper3d/rodin/v2.5",
        "controls": "Up to five views; Extreme-High; HD textures; PBR; delighting",
        "assessment": "Promising from first-hand comparisons; no controlled result on our roster yet."
      },
      {
        "model": "Tripo H3.1",
        "endpoint": "tripo3d/h3.1/image-to-3d",
        "controls": "Detailed geometry and texture; PBR; original-image texture alignment; separate geometry/texture seeds",
        "assessment": "Relevant alternative; broad ranking is not a measure of human likeness."
      }
    ],
    "discussion_evidence": [
      {
        "url": "https://sceneos.io/kb/3d-generators-compared/",
        "finding": "Author favored Meshy 7.1 face on one realistic person, with Rodin close. TRELLIS received only the front image while others received multiple views. Commercial site and small sample; not a controlled single-image ranking."
      },
      {
        "url": "https://www.reddit.com/r/generativeAI/comments/1u2k174/whats_the_best_image_to_3d_generator_thats_free/",
        "finding": "First-hand comments disagree on preferred model and report persistent face/hand/hair problems. Free/default tiers, versions and inputs differ; no consensus benchmark."
      },
      {
        "url": "https://www.reddit.com/r/aigamedev/comments/1xfr3vh/help_with_3d_human_modeling_especially_face/",
        "finding": "Recent positive Meshy report explicitly concerns chibi figures, while negative reports include older versions. Cannot extrapolate to photorealistic faces."
      }
    ],
    "evaluation": "Original PBR, unlit base color and texture-free clay, same input hash, same viewer/light/camera; inspect face, hands, silhouette, side and back. One trial cannot establish roster-wide superiority."
  },
