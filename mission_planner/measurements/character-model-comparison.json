  "diagnostic_invariants": [
    "Material variants preserve all source binary data and mesh definitions; asserted during publication.",
    "Same neutral viewer lighting and height-relative camera routines; close-up radius assertions passed."
  ],
  "visual_review": {
    "decision": "Neither reconstruction meets the final realism standard. Meshy is a promising facial alternative but does not justify replacing the roster from one sample.",
    "meshy_gains": [
      "Eye color and eye-region appearance closer to the reference in this sample.",
      "Finer irregular hair geometry than the smooth Hunyuan clumps."
    ],
    "meshy_defects": [
      "Mouth shape/expression changed; teeth are more exposed than the reference.",
      "Outer fingers on the negative-X hand are shortened or curled relative to the source; visible in clay as well as PBR.",
      "Trousers became much glossier under identical lighting.",
      "Hair remains a solid mesh and physical scale is uncalibrated."
    ],
    "hunyuan_defects": [
      "Eye appearance, mouth and face proportions drift from the input.",
      "Unlit view retains facial/texture discrepancies; clay retains simplified eye/hair/hand shapes, so changing lighting alone cannot solve them.",
      "PBR materials accentuate glossy skin and smooth hair clumps."
    ],
    "limits": [
      "One adult input and one sample per model; no child or senior Meshy tests yet.",
      "No identity similarity score or anatomy accuracy metric was measured.",
      "fal exposes 4K geometry but not the native Meshy texture-resolution selector; delivered maps were 2048 square.",
      "Returned source meshes have no skin/animation rigs; this test does not validate animation or MetaHuman conversion."
    ],
    "next_test": "Compare this identical input with the fal Hi3D portrait specialization and TRELLIS 2; Rodin 2.5 is another shortlisted candidate. Test the strongest candidate on a child and senior before any full-roster regeneration."
  },
