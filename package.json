{
  "name": "search-and-rescue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"SNR_SERVE_STATIC=0 tsx watch app/server.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx app/server.ts",
    "test": "tsx --test 'world/**/*.test.ts' 'world/**/*.test.mjs'",
    "assets": "python3 world/scripts/fetch-assets.py",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app world/studio world/scripts mission_control/gcs mission_control/perception/*.mjs *.ts *.json",
    "format:check": "prettier --check app world/studio world/scripts mission_control/gcs mission_control/perception/*.mjs *.ts *.json"
  },
  "dependencies": {
    "@epicgames-ps/lib-pixelstreamingfrontend-ue5.8": "^0.1.3",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "prettier": "3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
