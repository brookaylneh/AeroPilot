{
  "name": "wildlands-scenario-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"SNR_SERVE_STATIC=0 tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "playwright test",
    "assets": "python3 scripts/fetch-assets.py",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server shared tests scripts/*.mjs scripts/lib/*.mjs *.ts *.json",
    "format:check": "prettier --check src server shared tests scripts/*.mjs scripts/lib/*.mjs *.ts *.json",
    "export:public": "python3 scripts/export-public-source.py"
  },
  "dependencies": {
    "@epicgames-ps/lib-pixelstreamingfrontend-ue5.8": "^0.1.3",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "prettier": "3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
