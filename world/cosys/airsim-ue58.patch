+
+void RenderRequest::PollReadbacks()
+{
+    check(IsInRenderingThread());
+    if (FPlatformTime::Seconds() - readback_started_ > 15.0) {
+        UE_LOG(LogTemp, Fatal, TEXT("GPU sensor readback exceeded 15 seconds"));
+    }
+    for (const auto& readback : readbacks_) {
+        if (readback && !readback->IsReady())
+            return;
+    }
+    for (unsigned int i = 0; i < req_size_; ++i) {
+        if (!readbacks_[i])
+            continue;
+        auto& result = *results_[i];
+        int32 row_pitch = 0;
+        int32 buffer_height = 0;
+        const auto* pixels = static_cast<const FColor*>(readbacks_[i]->Lock(row_pitch, &buffer_height));
+        check(pixels && row_pitch >= result.width && buffer_height >= result.height);
+        result.bmp.SetNumUninitialized(result.width * result.height);
+        for (int32 row = 0; row < result.height; ++row) {
+            FMemory::Memcpy(result.bmp.GetData() + row * result.width,
+                pixels + row * row_pitch, result.width * sizeof(FColor));
+        }
+        readbacks_[i]->Unlock();
+    }
+    FCoreDelegates::OnEndFrameRT.Remove(readback_handle_);
+    readback_handle_.Reset();
+    CompleteTask();
+}
+
+void RenderRequest::CompleteTask()
+{
+    check(IsInRenderingThread());
+    readbacks_.Empty();
+    req_size_ = 0;
+    params_ = nullptr;
+    results_ = nullptr;
+    // Signalling releases the caller, which owns this object's lifetime.
+    wait_signal_->signal();
+}
