+#if WITH_DEV_AUTOMATION_TESTS
+
+#include "RenderRequest.h"
+#include "Misc/AutomationTest.h"
+#include "TextureResource.h"
+#include <atomic>
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FRenderReadbackTest, "SNR.Sensors.AsyncRgbReadback",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FRenderReadbackTest::RunTest(const FString& Parameters)
+{
+    struct FState {
+        TUniquePtr<RenderRequest> Request;
+        std::vector<std::shared_ptr<RenderRequest::RenderParams>> Params;
+        std::vector<std::shared_ptr<RenderRequest::RenderResult>> Results;
+        TArray<TArray<FColor>> Reference;
+        TArray<UTextureRenderTarget2D*> Targets;
+        USceneCaptureComponent2D* Component;
+        std::atomic<bool> Complete{false};
+    };
+    auto state = MakeShared<FState, ESPMode::ThreadSafe>();
+    state->Component = NewObject<USceneCaptureComponent2D>();
+    state->Component->AddToRoot();
+    const FIntPoint sizes[] = {{13, 7}, {257, 9}, {3840, 2160}};
+    for (int32 index = 0; index < 3; ++index) {
+        auto* target = NewObject<UTextureRenderTarget2D>();
+        target->AddToRoot();
+        target->ClearColor = FLinearColor(0.1f + index * 0.1f, 0.45f, 0.8f, 1.0f);
+        target->InitCustomFormat(sizes[index].X, sizes[index].Y, PF_B8G8R8A8, true);
+        target->UpdateResourceImmediate(true);
+        state->Targets.Add(target);
+        state->Params.push_back(std::make_shared<RenderRequest::RenderParams>(
+            state->Component, target, false, false, true));
+        state->Results.push_back(std::make_shared<RenderRequest::RenderResult>());
+    }
+    state->Reference.SetNum(3);
+    state->Request = MakeUnique<RenderRequest>(nullptr, [] {});
+    state->Request->params_ = state->Params.data();
+    state->Request->results_ = state->Results.data();
+    state->Request->req_size_ = 3;
+    ENQUEUE_RENDER_COMMAND(CompareSensorReadback)([state](FRHICommandListImmediate& commands) {
+        for (int32 index = 0; index < 3; ++index) {
+            auto* target = state->Targets[index];
+            auto* resource = target->GetRenderTargetResource();
+            FReadSurfaceDataFlags flags(RCM_UNorm, CubeFace_MAX);
+            flags.SetLinearToGamma(false);
+            commands.ReadSurfaceData(resource->GetRenderTargetTexture(),
+                FIntRect(0, 0, target->SizeX, target->SizeY), state->Reference[index], flags);
+        }
+        state->Request->ExecuteTask();
+    });
+    ADD_LATENT_AUTOMATION_COMMAND(FFunctionLatentCommand([this, state] {
+        if (!state->Complete.load()) {
+            ENQUEUE_RENDER_COMMAND(CheckSensorReadback)([state](FRHICommandListImmediate&) {
+                state->Complete.store(state->Request->req_size_ == 0);
+            });
+            return false;
+        }
+        for (int32 index = 0; index < 3; ++index) {
+            const auto& actual = *state->Results[index];
+            const auto& expected = state->Reference[index];
+            const auto* target = state->Targets[index];
+            TestEqual(TEXT("Width"), actual.width, target->SizeX);
+            TestEqual(TEXT("Height"), actual.height, target->SizeY);
+            TestEqual(TEXT("Pixel count"), actual.bmp.Num(), expected.Num());
+            bool identical = actual.bmp.Num() == expected.Num();
+            for (int32 pixel = 0; identical && pixel < expected.Num(); ++pixel) {
+                const auto a = actual.bmp[pixel];
+                const auto b = expected[pixel];
+                identical = a.R == b.R && a.G == b.G && a.B == b.B;
+            }
+            TestTrue(FString::Printf(TEXT("RGB byte equivalence %dx%d"),
+                target->SizeX, target->SizeY), identical);
+            TestTrue(TEXT("Reference has distinct colour channels"),
+                expected.Num() > 0 && expected[0].R != expected[0].G && expected[0].G != expected[0].B);
+            state->Targets[index]->RemoveFromRoot();
+        }
+        state->Component->RemoveFromRoot();
+        return true;
+    }));
+    return true;
+}
